# CogNivo Server-Side Environment Variables (Netlify Functions)
# Place these in Netlify Site Settings > Build & Deploy > Environment variables
# Or in local development: netlify dev

# Official Google Gemini API Key (Server-side ONLY; NEVER prefix with VITE_)
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Model Identifier (Defaults to 'gemini-2.5-flash')
GEMINI_MODEL="gemini-2.5-flash"
